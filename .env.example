# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production.

# ── Site ──────────────────────────────────────────────────────────────────────
# Only needed once a custom domain is attached. Drives canonical URLs, the
# sitemap and OG image URLs. Falls back to the Vercel subdomain when unset.
# NEXT_PUBLIC_SITE_URL="https://twana.dev"

# ── Contact form ──────────────────────────────────────────────────────────────
# Without these the site still builds and every page works; only the contact
# form fails, with a message naming the missing variable.
#
# Setup: create a Resend account, verify a sending domain, create an API key.
# CONTACT_FROM_EMAIL must be on the verified domain. Until a domain is
# verified, Resend's onboarding@resend.dev works for testing.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="site@example.com"
CONTACT_TO_EMAIL="you@example.com"
